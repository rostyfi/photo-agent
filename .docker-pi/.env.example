# ----------------------------------------------------------------------
# Pi Agent Authentication
# ----------------------------------------------------------------------
# Copy this file to .env and uncomment/fill in your API key.
# Only ONE provider key is needed.
#
#   cp .env.example .env
#
# ----------------------------------------------------------------------

# Anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_BASE_URL=

# OpenAI
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=

# Google Gemini
#GOOGLE_API_KEY=...

# DeepSeek
#DEEPSEEK_API_KEY=sk-...

# Groq
#GROQ_API_KEY=...

# Mistral
#MISTRAL_API_KEY=...

# xAI (Grok)
#XAI_API_KEY=...

# Cerebras
#CEREBRAS_API_KEY=...

# OpenRouter
#OPENROUTER_API_KEY=...

# Together AI
#TOGETHER_API_KEY=...

# Fireworks
#FIREWORKS_API_KEY=...

# Hugging Face
#HUGGINGFACE_API_KEY=...

# Ollama (local or remote)
# Set to your Ollama host. Defaults to http://localhost:11434 if unset.
# Pi doesn't ship with native Ollama support — configure it as a custom
# provider via ~/.pi/agent/models.json (see note below).
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_API_KEY=

# ----------------------------------------------------------------------
# Pi Agent Settings (optional)
# ----------------------------------------------------------------------

# Override default model
#PI_DEFAULT_MODEL=claude-sonnet-4-20250514

# Override default provider
#PI_DEFAULT_PROVIDER=anthropic

# Skip version check at startup (useful in offline/air-gapped environments)
#PI_SKIP_VERSION_CHECK=1

# ----------------------------------------------------------------------
# Custom Provider Note (Ollama)
# ----------------------------------------------------------------------
# Ollama isn't a built-in pi provider. To use it, add a custom provider
# in ~/.pi/agent/models.json. Ollama exposes an OpenAI-compatible API,
# so you can configure it like this:
#
# {
#   "providers": {
#     "ollama": {
#       "baseUrl": "http://localhost:11434/v1",
#       "apiKey": "ollama",
#       "api": "openai-completions",
#       "models": [
#         { "id": "llama3.1:8b", "name": "Llama 3.1 8B" },
#         { "id": "qwen3:14b",   "name": "Qwen 3 14B" }
#       ]
#     }
#   }
# }
#
# Then inside the container: pi --provider ollama --model llama3.1:8b
