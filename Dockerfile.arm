# ARM64 (Raspberry Pi) specific Dockerfile for Open Photo Agent
# Uses pre-built ARM64 wheels for sqlite-vec (available since 0.1.9a1)

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install build dependencies for pillow-heif
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libheif-dev \
        gcc \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY requirements.txt .

# Install all Python dependencies including sqlite-vec
# ARM64 wheels are available for sqlite-vec>=0.1.9a1
RUN uv pip install --system --no-cache -r requirements.txt

# Final stage
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV OPEN_PHOTO_AGENT_DASH_HOST=0.0.0.0

WORKDIR /app

# Install runtime dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libheif1 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Ensure the system can find system libraries
# On Debian ARM64, libheif and other libs are in /usr/lib/aarch64-linux-gnu
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/aarch64-linux-gnu:/usr/lib

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY . .

EXPOSE 8050

CMD ["/entrypoint.sh"]
