# LLM server connection settings
LOCAL_PHOTO_AGENT_LLM_HOST=192.168.0.29
LOCAL_PHOTO_AGENT_LLM_PORT=11434
LOCAL_PHOTO_AGENT_LLM_MODEL=ministral-3:8b

# LLM backend name (default: ollama)
# LOCAL_PHOTO_AGENT_LLM_BACKEND=ollama

# LLM request timeout in seconds (default: 600)
# LOCAL_PHOTO_AGENT_LLM_TIMEOUT=600

# Dash web app settings
LOCAL_PHOTO_AGENT_DASH_HOST=127.0.0.1
LOCAL_PHOTO_AGENT_DASH_PORT=8050
# LOCAL_PHOTO_AGENT_DASH_DEBUG=false

# Custom default prompt for image extraction
# LOCAL_PHOTO_AGENT_DEFAULT_PROMPT=

# Server-side folder path processed by the web UI (default: /photos)
# LOCAL_PHOTO_AGENT_FOLDER=/photos

# Vector embedding settings
# Enable/disable embedding generation (default: true)
# Requires sqlite-vec (recommended) or REST-based fallback, and Ollama v0.1.0+
# LOCAL_PHOTO_AGENT_EMBEDDING_ENABLED=true

# Embedding model to use (default: nomic-embed-text)
# Known models: clip-vit-base-patch32 (512d), all-minilm (384d), nomic-embed-text (768d)
# LOCAL_PHOTO_AGENT_EMBEDDING_MODEL=nomic-embed-text

# Embedding backend to use (default: ollama)
# Currently only ollama is supported
# LOCAL_PHOTO_AGENT_EMBEDDING_BACKEND=ollama

# Number of similar results to return (default: 10)
# LOCAL_PHOTO_AGENT_SIMILARITY_LIMIT=10

# Similarity metric to use (default: cosine)
# Currently only cosine is supported
# LOCAL_PHOTO_AGENT_SIMILARITY_METRIC=cosine

# "Copy Path" feature: maps server/container path prefixes to host paths so the
# displayed path is the one you can actually navigate to. Newline- or
# semicolon-separated list of container_prefix=host_prefix entries. Useful when
# the app runs inside Docker with a bind mount, e.g. /photos=/home/rost/Pictures
# When unset, the app auto-detects bind mounts from /proc/self/mountinfo.
# LOCAL_PHOTO_AGENT_REVEAL_MAP=
