# LLM server connection settings
OPEN_PHOTO_AGENT_LLM_HOST=192.168.0.29
OPEN_PHOTO_AGENT_LLM_PORT=11434
OPEN_PHOTO_AGENT_LLM_MODEL=ministral-3:8b

# LLM backend name (default: ollama)
# OPEN_PHOTO_AGENT_LLM_BACKEND=ollama

# LLM request timeout in seconds (default: 120)
# OPEN_PHOTO_AGENT_LLM_TIMEOUT=120

# Number of images to process per batch (default: 10; 0 = no limit)
# OPEN_PHOTO_AGENT_BATCH_SIZE=10

# Dash web app settings
OPEN_PHOTO_AGENT_DASH_HOST=127.0.0.1
OPEN_PHOTO_AGENT_DASH_PORT=8050
# OPEN_PHOTO_AGENT_DASH_DEBUG=false

# Custom default prompt for image extraction
# OPEN_PHOTO_AGENT_DEFAULT_PROMPT=

# Server-side folder path processed by the web UI (default: /photos)
# OPEN_PHOTO_AGENT_FOLDER=/photos

# Vector embedding settings
# Enable/disable embedding generation (default: true)
# Requires sqlite-vss (HARD REQUIREMENT) and Ollama v0.1.0+
# OPEN_PHOTO_AGENT_EMBEDDING_ENABLED=true

# Embedding model to use (default: nomic-embed-text)
# Known models: clip-vit-base-patch32 (512d), all-minilm (384d), nomic-embed-text (768d)
# OPEN_PHOTO_AGENT_EMBEDDING_MODEL=nomic-embed-text

# Embedding backend to use (default: ollama)
# Currently only ollama is supported
# OPEN_PHOTO_AGENT_EMBEDDING_BACKEND=ollama

# Number of similar results to return (default: 10)
# OPEN_PHOTO_AGENT_SIMILARITY_LIMIT=10

# Similarity metric to use (default: cosine)
# Currently only cosine is supported
# OPEN_PHOTO_AGENT_SIMILARITY_METRIC=cosine
